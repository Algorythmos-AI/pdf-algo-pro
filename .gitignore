# macOS
.DS_Store

# Xcode — the project is generated by XcodeGen from project.yml; only the SwiftPM lockfile is kept.
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcresult
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Secrets and signing material never enter git
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
*.cer
AuthKey_*.p8

# Real documents never enter git; test corpora are synthetic or licence-clean and generated.
*.pdf
!Tests/Fixtures/Synthetic/**/*.pdf
!**/Tests/Fixtures/Synthetic/**/*.pdf

# Tooling
__pycache__/
.venv/
node_modules/
.pytest_cache/

# Local agent worktrees
.claude/worktrees/
