    "Turn paper into searchable PDFs with the camera. Text is recognised on this device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transformez vos papiers en PDF avec recherche grâce à l’appareil photo. Le texte est reconnu sur cet appareil."
