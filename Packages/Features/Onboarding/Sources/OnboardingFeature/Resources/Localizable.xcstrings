  "strings" : {
    "Ask your document" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrogez votre document"
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer"
          }
        }
      }
    },
    "Fill in forms, add your signature, highlight and add notes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplissez des formulaires, ajoutez votre signature, surlignez et ajoutez des notes."
          }
        }
      }
    },
    "Get summaries and answers with page citations. It runs on this device, and nothing is sent anywhere." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez des résumés et des réponses avec les pages citées. Tout se fait sur cet appareil, et rien n’est envoyé."
          }
        }
      }
    },
    "Merge documents, reorder pages and add a password. Your documents stay on this device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionnez des documents, réorganisez les pages et ajoutez un mot de passe. Vos documents restent sur cet appareil."
          }
        }
      }
    },
    "Organise and protect" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiser et protéger"
          }
        }
      }
    },
    "Page %lld of %lld" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page %1$lld sur %2$lld"
          }
        }
      }
    },
    "Scan to PDF" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numériser en PDF"
          }
        }
      }
    },
