{
  "sourceLanguage" : "en",
  "strings" : {
    "Add your signature, highlight, write notes, reorder pages and lock files with a password." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signez, surlignez, annotez, réorganisez les pages et protégez vos fichiers par mot de passe."
          }
        }
      }
    },
    "Ask your documents" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrogez vos documents"
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer"
          }
        }
      }
    },
    "Do more with every file" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez plus de chaque fichier"
          }
        }
      }
    },
    "Edit, sign and organise" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez, signez, organisez"
          }
        }
      }
    },
    "Merge documents, make them smaller and find any word. Everything stays on this device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fusionnez des documents, allégez-les et retrouvez n’importe quel mot. Tout reste sur cet appareil."
          }
        }
      }
    },
    "Page %lld of %lld" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page %1$lld sur %2$lld"
          }
        }
      }
    },
    "Point the camera at paper and get a clean, searchable PDF in seconds." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visez un papier avec l’appareil photo et obtenez en quelques secondes un PDF net, avec recherche."
          }
        }
      }
    },
    "Scan anything to PDF" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numérisez tout en PDF"
          }
        }
      }
    },
    "Skip" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer"
          }
        }
      }
    },
    "Summaries and answers that show the pages they come from. It all runs on this device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des résumés et des réponses qui citent leurs pages. Tout se fait sur cet appareil."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
