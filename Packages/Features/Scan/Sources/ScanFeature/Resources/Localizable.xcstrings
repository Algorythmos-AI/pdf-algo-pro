    "Scanned pages become a searchable PDF. Text is recognised on this device, in English and French." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages numérisées deviennent un PDF interrogeable. Le texte est reconnu sur cet appareil, en anglais et en français."
          }
        }
      }
    },
    "Tap a page to rotate, move or delete it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une page pour la faire pivoter, la déplacer ou la supprimer."
          }
        }
      }
    },
    "Your pages are kept, so you can try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance du texte n’a pas abouti. Vos pages sont conservées : vous pouvez réessayer."
          }
        }
      }
    },
