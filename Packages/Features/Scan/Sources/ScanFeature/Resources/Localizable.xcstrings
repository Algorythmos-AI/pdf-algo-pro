        }
      }
    },
    "This device has no document camera. You can make a PDF from photos of pages instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n’a pas de scanner de documents. Vous pouvez plutôt créer un PDF à partir de photos de pages."
          }
        }
      }
    },
