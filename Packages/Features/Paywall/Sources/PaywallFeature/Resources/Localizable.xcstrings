          }
        }
      }
    },
    "It starts again tomorrow. Pro has no daily limit." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se renouvelle demain. Pro n’a aucune limite quotidienne."
          }
        }
      }
    },
    "Less than a day of your trial is left, so there’s no reminder to set." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste moins d’un jour d’essai, il n’y a donc plus de rappel à programmer."
