    },
    "This Apple Account already has Pro." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte Apple a déjà Pro."
          }
        }
      }
    },
    "This Apple Account has no Pro purchase to restore. If you bought Pro with another account, sign in to the App Store with it and try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte Apple n’a aucun achat de Pro à restaurer. Si vous avez acheté Pro avec un autre compte, connectez-vous à l’App Store avec ce compte et réessayez."
          }
