    },
    "PDF Algo Pro is free to use. Pro removes the daily limits." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF Algo Pro est gratuit. Pro supprime les limites quotidiennes."
