    "Welcome to Pro" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenue dans Pro"
          }
        }
      }
    },
    "You can cancel at any time: open the Settings app, tap your name (Apple Account), then Subscriptions. Or tap Manage subscription in PDF Algo Pro’s Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez résilier à tout moment : ouvrez l’app Réglages, touchez votre nom (compte Apple), puis Abonnements. Ou touchez Gérer l’abonnement dans les Réglages de PDF Algo Pro."
          }
        }
      }
    },
    "Your documents are always yours: opening, reading, signing, sharing and exporting never need Pro." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos documents restent les vôtres : les ouvrir, les lire, les signer, les partager et les exporter ne demande jamais Pro."
          }
        }
      }
    },
    "Your purchases are restored, and Pro is on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos achats sont restaurés, et Pro est activé."
