    "Summaries, answers and extraction on this device, with no daily limit." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumés, réponses et extraction sur cet appareil, sans limite quotidienne."
