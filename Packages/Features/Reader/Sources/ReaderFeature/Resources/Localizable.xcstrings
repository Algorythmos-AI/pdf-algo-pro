    },
    "That password didn't open the document." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe n’a pas ouvert le document."
          }
        }
      }
    },
    "The author of this document doesn't allow notes, markup or changes to it, so nothing was changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’auteur de ce document n’autorise ni notes, ni annotations, ni modifications, rien n’a donc été changé."
          }
        }
      }
    },
