    "Text recognition didn't finish. The document hasn't changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance du texte n’a pas abouti. Le document n’a pas changé."
