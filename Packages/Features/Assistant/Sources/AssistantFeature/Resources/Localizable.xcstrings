{
  "sourceLanguage" : "en",
  "strings" : {
    "AI features are turned off in Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fonctionnalités d’IA sont désactivées dans les réglages."
          }
        }
      }
    },
    "Answers come only from this document and cite their pages." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses proviennent uniquement de ce document et citent leurs pages."
          }
        }
      }
    },
    "Apple Intelligence is still getting ready on this device. Try again in a little while." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence est encore en cours de préparation sur cet appareil. Réessayez dans un moment."
          }
        }
      }
    },
