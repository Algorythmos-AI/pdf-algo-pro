    "Summarise" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumer"
          }
        }
      }
    },
    "Task" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâche"
          }
        }
      }
    },
    "That didn't work" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela n’a pas fonctionné"
          }
        }
      }
    },
    "The answer isn't in the text of this document, so nothing was guessed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse ne figure pas dans le texte de ce document, rien n’a donc été deviné."
          }
        }
      }
    },
    "The request didn't finish. Your document hasn't changed. Try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande n’a pas abouti. Votre document n’a pas changé. Réessayez."
          }
        }
      }
    },
    "This device doesn't support Apple Intelligence. Reading, search, markup and scanning all still work." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil ne prend pas en charge Apple Intelligence. La lecture, la recherche, les annotations et la numérisation fonctionnent toujours."
          }
        }
      }
    },
    "This looks like a scan. Choose Recognise text in the reader's More menu, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ressemble à une numérisation. Choisissez « Reconnaître le texte » dans le menu Plus du lecteur, puis réessayez."
          }
        }
      }
    },
    "This request is too large for the on-device model. Try a shorter question or a smaller document." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande est trop volumineuse pour le modèle sur l’appareil. Essayez une question plus courte ou un document plus petit."
          }
        }
      }
    },
    "To" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À"
          }
        }
      }
    },
    "Total" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total"
          }
        }
      }
    },
    "Try again" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayer"
          }
        }
      }
    },
    "Turn on Apple Intelligence in the Settings app to use it here. Everything else works without it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans l’app Réglages pour l’utiliser ici. Tout le reste fonctionne sans."
          }
        }
      }
    },
    "p. %lld" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p. %lld"
