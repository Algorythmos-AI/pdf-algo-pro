        }
      }
    },
    "Before each save, the app keeps the version it replaces for 30 days, so a change can be undone. Deleting this history leaves your documents as they are." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant chaque enregistrement, l’app conserve pendant 30 jours la version qu’elle remplace, pour qu’une modification puisse être annulée. Supprimer cet historique ne modifie pas vos documents."
          }
        }
      }
    },
