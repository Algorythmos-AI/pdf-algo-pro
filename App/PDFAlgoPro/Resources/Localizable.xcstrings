          "stringUnit" : {
            "state" : "translated",
            "value" : "Document"
          }
        }
      }
    },
    "Generated on this device. Check important details in the document." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Généré sur cet appareil. Vérifiez les détails importants dans le document."
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "Open Document" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir un document"
          }
        }
      }
    },
    "Open Settings" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir Réglages"
          }
        }
      }
    },
    "Opens a document from your PDF Algo Pro library." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre un document de votre bibliothèque PDF Algo Pro."
          }
        }
      }
    },
    "Opens the scanner to make a searchable PDF on this device." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre le scanner pour créer un PDF interrogeable sur cet appareil."
          }
        }
      }
    },
    "Pages cited: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pages citées : %@"
          }
        }
      }
    },
    "PDF Algo Pro is locked. Open it and unlock it, then try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF Algo Pro est verrouillé. Ouvrez-le et déverrouillez-le, puis réessayez."
          }
        }
      }
    },
    "PDF Algo Pro is still starting. Try again in a moment." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF Algo Pro démarre encore. Réessayez dans un instant."
          }
        }
      }
    },
    "Scan Document" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numériser un document"
          }
        }
      }
    },
    "Summaries need Apple Intelligence on this device, and AI features turned on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résumés nécessitent Apple Intelligence sur cet appareil et les fonctionnalités d’IA activées."
          }
        }
      }
    },
    "Summarise Document" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résumer un document"
          }
        }
      }
    },
    "Summarises a document from your library on this device, with the pages it draws on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résume un document de votre bibliothèque sur cet appareil, avec les pages sur lesquelles il s’appuie."
          }
        }
      }
    },
    "That document has no text to summarise yet. Open it and recognise its text first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document n’a pas encore de texte à résumer. Ouvrez-le et lancez d’abord la reconnaissance du texte."
          }
        }
      }
    },
    "That document is no longer in your library." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document n’est plus dans votre bibliothèque."
          }
        }
      }
    },
    "The summary couldn't be made. Try again in the app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le résumé n’a pas pu être créé. Réessayez dans l’app."
          }
        }
      }
    },
    "This device has no passcode, so App Lock can't confirm it's you. To use App Lock again, set a passcode in the Settings app, then turn App Lock on in PDF Algo Pro." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil n’a pas de code, donc le verrouillage de l’app ne peut pas confirmer votre identité. Pour l’utiliser de nouveau, définissez un code dans l’app Réglages, puis activez le verrouillage de l’app dans PDF Algo Pro."
          }
        }
      }
    },
    "Unlock with Face ID" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouiller avec Face ID"
          }
        }
      }
    },
    "Unlock with Optic ID" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouiller avec Optic ID"
          }
        }
      }
    },
    "Unlock with passcode" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouiller avec le code"
          }
        }
      }
    },
    "Unlock with Touch ID" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouiller avec Touch ID"
          }
        }
      }
    },
    "Unlock your documents" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouiller vos documents"
          }
        }
      }
    },
    "Your documents are locked" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos documents sont verrouillés"
          }
        }
      }
    },
    "If your PDF Algo Pro trial is still running, it ends within a day. To manage or cancel it, open the Settings app, tap your name (Apple Account), then Subscriptions." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si votre essai de PDF Algo Pro est toujours en cours, il se termine dans un jour au plus. Pour le gérer ou le résilier, ouvrez l’app Réglages, touchez votre nom (compte Apple), puis Abonnements."
          }
        }
      }
    },
    "Your PDF Algo Pro trial ends on %@. To manage or cancel it, open the Settings app, tap your name (Apple Account), then Subscriptions. Or tap Manage subscription in PDF Algo Pro’s Settings." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre essai de PDF Algo Pro se termine le %@. Pour le gérer ou le résilier, ouvrez l’app Réglages, touchez votre nom (compte Apple), puis Abonnements. Ou touchez Gérer l’abonnement dans les Réglages de PDF Algo Pro."
          }
        }
      }
    },
    "Your trial ends soon" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre essai se termine bientôt"
          }
        }
      }
    },
    "Trial reminder" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappel d’essai"
          }
        }
      }
    },
    "You’ve used today’s free summaries. They start again tomorrow, and Pro has no daily limit." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez utilisé les résumés gratuits du jour. Ils reprennent demain, et Pro n’a aucune limite quotidienne."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
