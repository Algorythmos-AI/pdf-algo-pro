{
  "$description": "PDF Algo Pro design tokens (Design Tokens Community Group format). Source of truth for docs/design-system.md; generated into Packages/DesignSystem by scripts/design/generate_tokens.py. Brand values come from the organisation brand standard; Increase Contrast values are proposed in the design system.",
  "color": {
    "brand": {
      "tint": { "$type": "color", "$value": "#6D28D9", "$extensions": { "com.algorythmos.appearances": { "light": "#6D28D9", "dark": "#A78BFA", "lightHighContrast": "#4C1D95", "darkHighContrast": "#C4B5FD" } } },
      "strong": { "$type": "color", "$value": "#5B21B6", "$extensions": { "com.algorythmos.appearances": { "light": "#5B21B6", "dark": "#8B5CF6", "lightHighContrast": "#4C1D95", "darkHighContrast": "#C4B5FD" } } },
      "fill": { "$type": "color", "$value": "#6D28D9", "$extensions": { "com.algorythmos.appearances": { "light": "#6D28D9", "dark": "#A78BFA", "lightHighContrast": "#4C1D95", "darkHighContrast": "#C4B5FD" } } },
      "onFill": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "com.algorythmos.appearances": { "light": "#FFFFFF", "dark": "#08080C", "lightHighContrast": "#FFFFFF", "darkHighContrast": "#000000" } } }
    },
    "intelligence": {
      "tint": { "$type": "color", "$value": "#0E7490", "$extensions": { "com.algorythmos.appearances": { "light": "#0E7490", "dark": "#22D3EE", "lightHighContrast": "#155E75", "darkHighContrast": "#67E8F9" } } },
      "fill": { "$type": "color", "$value": "#0E7490", "$extensions": { "com.algorythmos.appearances": { "light": "#0E7490", "dark": "#22D3EE", "lightHighContrast": "#155E75", "darkHighContrast": "#67E8F9" } } },
      "onFill": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "com.algorythmos.appearances": { "light": "#FFFFFF", "dark": "#08080C", "lightHighContrast": "#FFFFFF", "darkHighContrast": "#000000" } } }
    },
    "icon": {
      "gradientStart": { "$type": "color", "$value": "#F43F5E", "$description": "App icon only, not a UI colour.", "$extensions": { "com.algorythmos.appearances": { "light": "#F43F5E", "dark": "#F43F5E", "lightHighContrast": "#F43F5E", "darkHighContrast": "#F43F5E" } } },
      "gradientMid": { "$type": "color", "$value": "#C026D3", "$description": "App icon only, not a UI colour.", "$extensions": { "com.algorythmos.appearances": { "light": "#C026D3", "dark": "#C026D3", "lightHighContrast": "#C026D3", "darkHighContrast": "#C026D3" } } },
      "fold": { "$type": "color", "$value": "#DDD6FE", "$description": "App icon only, not a UI colour.", "$extensions": { "com.algorythmos.appearances": { "light": "#DDD6FE", "dark": "#DDD6FE", "lightHighContrast": "#DDD6FE", "darkHighContrast": "#DDD6FE" } } },
      "stagingBadge": { "$type": "color", "$value": "#F59E0B", "$description": "App icon only, not a UI colour.", "$extensions": { "com.algorythmos.appearances": { "light": "#F59E0B", "dark": "#F59E0B", "lightHighContrast": "#F59E0B", "darkHighContrast": "#F59E0B" } } }
    },
    "logo": {
      "mark": { "$type": "color", "$value": "#3715E0", "$description": "Algorythmos company mark only (organisation brand standard); the same in every appearance.", "$extensions": { "com.algorythmos.appearances": { "light": "#3715E0", "dark": "#3715E0", "lightHighContrast": "#3715E0", "darkHighContrast": "#3715E0" } } },
      "dotStart": { "$type": "color", "$value": "#4A18E8", "$description": "Algorythmos company mark only (organisation brand standard); the same in every appearance.", "$extensions": { "com.algorythmos.appearances": { "light": "#4A18E8", "dark": "#4A18E8", "lightHighContrast": "#4A18E8", "darkHighContrast": "#4A18E8" } } },
      "dotEnd": { "$type": "color", "$value": "#8420F5", "$description": "Algorythmos company mark only (organisation brand standard); the same in every appearance.", "$extensions": { "com.algorythmos.appearances": { "light": "#8420F5", "dark": "#8420F5", "lightHighContrast": "#8420F5", "darkHighContrast": "#8420F5" } } },
      "tile": { "$type": "color", "$value": "#FFFFFF", "$description": "The light tile the company mark always sits on, so it keeps its contrast in dark appearances.", "$extensions": { "com.algorythmos.appearances": { "light": "#FFFFFF", "dark": "#FFFFFF", "lightHighContrast": "#FFFFFF", "darkHighContrast": "#FFFFFF" } } }
    },
    "system": {
      "backgroundPrimary": { "$type": "color", "$value": "systemBackground" },
      "backgroundSecondary": { "$type": "color", "$value": "secondarySystemBackground" },
      "backgroundGrouped": { "$type": "color", "$value": "systemGroupedBackground" },
      "backgroundGroupedElevated": { "$type": "color", "$value": "secondarySystemGroupedBackground" },
      "labelPrimary": { "$type": "color", "$value": "label" },
      "labelSecondary": {
        "$type": "color",
        "$value": "secondaryLabel",
        "$description": "secondaryLabel is 3.3:1 on grouped backgrounds; these values keep 4.5:1 on every system background.",
        "$extensions": {
          "com.algorythmos.appearances": {
            "light": "#5E5E66",
            "dark": "#A1A1A8",
            "lightHighContrast": "#45454C",
            "darkHighContrast": "#C4C4CC"
          }
        }
      },
      "labelTertiary": { "$type": "color", "$value": "tertiaryLabel" },
      "separator": { "$type": "color", "$value": "separator" },
      "fillPrimary": { "$type": "color", "$value": "systemFill" },
      "fillSecondary": { "$type": "color", "$value": "secondarySystemFill" },
      "fillTertiary": { "$type": "color", "$value": "tertiarySystemFill" },
      "statusSuccess": { "$type": "color", "$value": "systemGreen" },
      "statusWarning": { "$type": "color", "$value": "systemOrange" },
      "statusError": { "$type": "color", "$value": "systemRed" },
      "destructiveText": {
        "$type": "color",
        "$value": "systemRed",
        "$description": "systemRed is 3.6:1 on white; these values keep 4.5:1 on every system background, for destructive button titles such as Delete.",
        "$extensions": {
          "com.algorythmos.appearances": {
            "light": "#C2181F",
            "dark": "#FF8A8A",
            "lightHighContrast": "#9F1016",
            "darkHighContrast": "#FF9A9A"
          }
        }
      },
      "link": { "$type": "color", "$value": "link" }
    }
  },
  "space": {
    "s0": { "$type": "dimension", "$value": 0 },
    "s050": { "$type": "dimension", "$value": 4 },
    "s100": { "$type": "dimension", "$value": 8 },
    "s150": { "$type": "dimension", "$value": 12 },
    "s200": { "$type": "dimension", "$value": 16 },
    "s300": { "$type": "dimension", "$value": 24 },
    "s400": { "$type": "dimension", "$value": 32 },
    "s500": { "$type": "dimension", "$value": 40 },
    "s600": { "$type": "dimension", "$value": 48 },
    "s800": { "$type": "dimension", "$value": 64 }
  },
  "opacity": {
    "brandGlow": { "$type": "number", "$value": 0.1, "$description": "The brand tint behind the Home header; low enough that secondary text over it keeps 4.5:1 (tested in DesignSystemTests)." }
  },
  "size": {
    "targetMinimum": { "$type": "dimension", "$value": 44 },
    "readableWidth": { "$type": "dimension", "$value": 672 }
  },
  "contrastPairs": [
    { "foreground": "color.brand.onFill", "background": "color.brand.fill", "minRatio": 4.5 },
    { "foreground": "color.intelligence.onFill", "background": "color.intelligence.fill", "minRatio": 4.5 },
    { "foreground": "color.logo.mark", "background": "color.logo.tile", "minRatio": 4.5 },
    { "foreground": "color.logo.dotEnd", "background": "color.logo.tile", "minRatio": 3 }
  ]
}
